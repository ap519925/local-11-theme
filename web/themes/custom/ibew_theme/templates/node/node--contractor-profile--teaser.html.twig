<article
	class="card ibew-contractor-card ibew-card h-100 p-0 overflow-hidden d-flex flex-row border-0 shadow-sm rounded-3" style="background-color: #1e3a5f !important; color: #ffffff !important; border: 1px solid rgba(255,255,255,0.08) !important;" data-id="{{ node.id }}" data-name="{{ label }}" data-phone="{{ node.field_phone.value }}" data-service-areas="{{ node.field_service_areas.value|render|striptags|trim }}">

	{# Image/Logo Section - LEFT SIDE #}
	<div class="position-relative d-flex align-items-center justify-content-center flex-shrink-0" style="width: 160px; min-height: 140px; background: linear-gradient(135deg, #152a45 0%, #1e3a5f 100%) !important; border-right: 1px solid rgba(255,255,255,0.08);">
		{% if not node.field_image.isEmpty() and node.field_image.entity %}
			{% set image_url = file_url(node.field_image.entity.uri.value) %}
			<img src="{{ image_url }}" alt="{{ node.field_image.alt }}" class="img-fluid" style="max-height: 100%; max-width: 100%; object-fit: contain; padding: 12px;">
		{% else %}
			{# SVG Placeholder - Lightning bolt with company initial #}
			<div class="text-center d-flex flex-column align-items-center justify-content-center h-100 w-100 p-2">
				<div style="width: 64px; height: 64px; border-radius: 50%; background: rgba(247, 201, 72, 0.15); display: flex; align-items: center; justify-content: center; margin-bottom: 0.5rem;">
					<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="#f7c948" viewbox="0 0 16 16">
						<path d="M5.52.359A.5.5 0 0 1 6 0h4a.5.5 0 0 1 .474.658L8.694 6H12.5a.5.5 0 0 1 .395.807l-7 9a.5.5 0 0 1-.873-.454L6.823 9.5H3.5a.5.5 0 0 1-.48-.641l2.5-8.5z"/>
					</svg>
				</div>
				<span style="color: rgba(255,255,255,0.6); font-size: 0.6rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; line-height: 1.2; max-width: 120px; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">{{ label }}</span>
			</div>
		{% endif %}
	</div>

	{# Content Section - RIGHT SIDE #}
	<div
		class="card-body p-3 d-flex flex-column flex-grow-1" style="background: transparent !important;">
		{# Specialties Badges #}
		<div class="d-flex flex-wrap gap-1 mb-2">
			{% for item in node.field_specialties %}
				<span class="badge rounded-1 px-2 py-1 text-uppercase" style="font-size: 0.6rem; background-color: rgba(247, 201, 72, 0.2) !important; color: #f7c948 !important;">
					{{ item.entity.label }}
				</span>
			{% endfor %}
		</div>

		<h3 class="card-title fw-bold mb-1 font-oswald text-uppercase lh-base" style="font-size: 1rem; color: #ffffff !important;">
			<a href="javascript:void(0);" class="text-decoration-none stretched-link" style="color: #ffffff !important;">
				{{ label }}
			</a>
		</h3>

		{% if node.field_contact_person.value %}
			<p class="small mb-2" style="font-size: 0.8rem; color: rgba(255,255,255,0.7) !important;">
				{{ node.field_contact_person.value }}
			</p>
		{% endif %}

		{# Service Areas - compact #}
		{% if node.field_service_areas.value %}
			<div class="small mb-2" style="font-size: 0.75rem; color: rgba(255,255,255,0.6) !important;">
				<strong class="text-uppercase" style="font-size: 0.7rem; color: #f7c948 !important;">Areas:</strong>
				{{ node.field_service_areas.value }}
			</div>
		{% endif %}

		<div class="mt-auto position-relative d-flex flex-wrap gap-2 align-items-center" style="z-index: 2;">
			{% if node.field_phone.value %}
				<a href="tel:{{ node.field_phone.value }}" class="text-decoration-none d-flex align-items-center gap-1 small" style="color: #f7c948 !important;">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewbox="0 0 16 16">
						<path fill-rule="evenodd" d="M1.885.511a1.745 1.745 0 0 1 2.61.163L6.29 2.98c.329.445.445.974.315 1.494l-.547 2.19a.678.678 0 0 0 .178.643l2.457 2.457a.678.678 0 0 0 .644.178l2.189-.547a1.745 1.745 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.634 18.634 0 0 1-7.01-4.42 18.634 18.634 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877L1.885.511z"/>
					</svg>
					{{ node.field_phone.value }}
				</a>
			{% endif %}

			{% if node.field_email.value %}
				<a href="mailto:{{ node.field_email.value }}" class="text-decoration-none d-flex align-items-center gap-1 small" style="color: rgba(255,255,255,0.8) !important;">
					<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewbox="0 0 16 16">
						<path d="M.05 3.555A2 2 0 0 1 2 2h12a2 2 0 0 1 1.95 1.555L8 8.414.05 3.555ZM0 4.697v7.104l5.803-3.558L0 4.697ZM6.761 8.83l-6.57 4.027A2 2 0 0 0 2 14h12a2 2 0 0 0 1.808-1.144l-6.57-4.027L8 9.586l-1.239-.757Zm3.436-.586L16 11.801V4.697l-5.803 3.546Z"/>
					</svg>
					{{ node.field_email.value }}
				</a>
			{% endif %}

			{% if node.field_website.uri %}
				<a href="{{ node.field_website.uri }}" target="_blank" class="btn btn-sm fw-bold ms-auto" style="font-size: 0.75rem; padding: 0.25rem 0.75rem; background-color: #f7c948 !important; color: #1e3a5f !important; border: none !important;">
					Website
				</a>
			{% endif %}
		</div>

	</div>
</article>
