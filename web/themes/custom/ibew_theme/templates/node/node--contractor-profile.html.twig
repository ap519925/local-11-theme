{#
/**
 * @file
 * Theme override to display a contractor profile node.
 *
 * Available variables:
 * - node: The node entity with limited access to object properties and methods.
 * - label: The title of the node.
 * - content: All node items. Use {{ content }} to print them all,
 *   or print a subset such as {{ content.field_example }}. Use
 *   {{ content|without('field_example') }} to temporarily suppress the printing
 *   of a given child element.
 * - author_picture: The node author user entity, rendered using the "compact"
 *   view mode.
 * - metadata: Metadata for this node.
 * - date: Themed creation date field.
 * - author_name: Themed author name field.
 * - url: Direct URL of the current node.
 * - display_submitted: Whether submission information should be displayed.
 * - attributes: HTML attributes for the containing element.
 * - title_attributes: HTML attributes for the title.
 * - content_attributes: HTML attributes for the content.
 * - author_attributes: HTML attributes for the author.
 * - title_prefix: Additional output populated by modules, intended to be
 *   displayed in front of the main title tag that appears in the template.
 * - title_suffix: Additional output populated by modules, intended to be
 *   displayed after the main title tag that appears in the template.
 * - view_mode: View mode; for example, "teaser" or "full".
 * - teaser: Flag for the teaser state (a shortcut for view_mode == 'teaser').
 * - page: Flag for the full page state.
 * - readmore: Flag for more state.
 */
#}

<article{{attributes.addClass('node','node--type-'~node.bundle,view_mode?'node--view-mode-'~view_mode,'my-5')}}>

	{{ title_prefix }}
	{% if not page %}
		<h2{{title_attributes.addClass('node__title')}}>
			<a href="{{ url }}" rel="bookmark">{{ label }}</a>
		</h2>
	{% endif %}
	{{ title_suffix }}

	{% if display_submitted %}
		<footer class="node__meta">
			{{ author_picture }}
			<div{{author_attributes.addClass('node__submitted')}}>
				{% trans %}Submitted by
				{{ author_name }}
				on
				{{ date }}{% endtrans %}
				{{ metadata }}
			</div>
		</footer>
	{% endif %}

	<div{{content_attributes.addClass('node__content')}}>
		<div class="container">
			<div class="row align-items-center mb-0">
				<div class="col">
					<a href="/contractors" class="d-inline-flex align-items-center gap-2 mb-4 text-decoration-none" style="color: var(--ibew-accent, #f7c948); font-weight: 600; font-family: 'Oswald', sans-serif; text-transform: uppercase; letter-spacing: 0.05em;">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left" viewbox="0 0 16 16">
							<path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/>
						</svg>
						Back to Directory
					</a>
				</div>
			</div>

			<div class="ibew-card shadow-lg border-0 rounded-4 overflow-hidden mb-5">
				<div
					class="row g-0">
					{# LEFT COLUMN: Image / Logo Backdrop #}
					<div class="col-lg-4 position-relative d-flex align-items-center justify-content-center" style="min-height: 250px; background-color: var(--ibew-primary, #1e3a5f) !important;">
						<div class="position-absolute top-0 start-0 w-100 h-100 opacity-25" style="background-image: url('/themes/custom/ibew_theme/images/pattern-bg.png'); background-size: cover; mix-blend-mode: overlay;"></div>

						<div class="position-relative z-10 p-4 text-center w-100 h-100 d-flex flex-column align-items-center justify-content-center">
							{% if not node.field_image.isEmpty() and node.field_image.entity %}
								{% set image_url = file_url(node.field_image.entity.uri.value) %}
								<div class="bg-white rounded-circle shadow p-3 mb-3 d-flex align-items-center justify-content-center mx-auto" style="width: 180px; height: 180px;">
									<img src="{{ image_url }}" alt="{{ node.field_image.alt }}" class="img-fluid rounded-circle" style="max-height: 100%; max-width: 100%; object-fit: contain;">
								</div>
							{% else %}
								<div class="bg-white rounded-circle shadow p-3 mb-3 d-flex align-items-center justify-content-center mx-auto" style="width: 180px; height: 180px;">
									<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="var(--ibew-primary, #1e3a5f)" viewbox="0 0 16 16">
										<path d="M5.52.359A.5.5 0 0 1 6 0h4a.5.5 0 0 1 .474.658L8.694 6H12.5a.5.5 0 0 1 .395.807l-7 9a.5.5 0 0 1-.873-.454L6.823 9.5H3.5a.5.5 0 0 1-.48-.641l2.5-8.5z"/>
									</svg>
								</div>
							{% endif %}

							{% if node.field_specialties.value %}
								<div class="d-flex flex-wrap justify-content-center gap-2 mt-2">
									{% for item in node.field_specialties %}
										<span class="badge px-3 py-2 text-uppercase fw-bold shadow-sm" style="font-size: 0.75rem; background-color: var(--ibew-accent, #f7c948); color: var(--ibew-primary, #1e3a5f);">
											{{ item.entity.label }}
										</span>
									{% endfor %}
								</div>
							{% endif %}
						</div>
					</div>

					{# RIGHT COLUMN: Details #}
					<div class="col-lg-8 ibew-card-surface d-flex flex-column" style="border-left: 1px solid rgba(128,128,128,0.1);">
						<div class="card-body p-4 p-lg-5 flex-grow-1">
							<h1 class="display-5 fw-bold font-oswald text-uppercase text-primary mb-1">{{ label }}</h1>

							{% if node.field_contact_person.value %}
								<h4 class="text-muted fw-normal mb-4 opacity-75">
									<i class="bi bi-person-badge me-2"></i>
									{{ node.field_contact_person.value }}
								</h4>
							{% endif %}

							<div
								class="row g-4 mb-4">
								{# Contact Info Card #}
								<div class="col-md-6">
									<div class="card border-0 h-100 rounded-3 p-4" style="background: rgba(128,128,128, 0.08);">
										<h5 class="fw-bold font-oswald text-uppercase border-bottom border-secondary border-opacity-25 pb-2 mb-3">Contact Information</h5>
										<ul class="list-unstyled mb-0 d-flex flex-column gap-3">
											{% if node.field_phone.value %}
												<li class="d-flex align-items-center gap-2">
													<div class="text-warning">
														<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewbox="0 0 16 16"><path fill-rule="evenodd" d="M1.885.511a1.745 1.745 0 0 1 2.61.163L6.29 2.98c.329.445.445.974.315 1.494l-.547 2.19a.678.678 0 0 0 .178.643l2.457 2.457a.678.678 0 0 0 .644.178l2.189-.547a1.745 1.745 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.634 18.634 0 0 1-7.01-4.42 18.634 18.634 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877L1.885.511z"/></svg>
													</div>
													<a href="tel:{{ node.field_phone.value }}" class="text-decoration-none fw-medium fs-5" style="color: inherit;">{{ node.field_phone.value }}</a>
												</li>
											{% endif %}

											{% if node.field_email.value %}
												<li class="d-flex align-items-center gap-2">
													<div class="text-warning">
														<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewbox="0 0 16 16"><path d="M.05 3.555A2 2 0 0 1 2 2h12a2 2 0 0 1 1.95 1.555L8 8.414.05 3.555ZM0 4.697v7.104l5.803-3.558L0 4.697ZM6.761 8.83l-6.57 4.027A2 2 0 0 0 2 14h12a2 2 0 0 0 1.808-1.144l-6.57-4.027L8 9.586l-1.239-.757Zm3.436-.586L16 11.801V4.697l-5.803 3.546Z"/></svg>
													</div>
													<a href="mailto:{{ node.field_email.value }}" class="text-decoration-none" style="color: inherit;">{{ node.field_email.value }}</a>
												</li>
											{% endif %}

											{% if node.field_website.uri %}
												<li class="d-flex align-items-center gap-2">
													<div class="text-warning">
														<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewbox="0 0 16 16"><path fill-rule="evenodd" d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0ZM2.04 4.326c.325 1.329 2.532 2.524 5.897 2.94v5.396c-2.25.265-4.11-1.223-4.836-3.048A7.99 7.99 0 0 1 2.04 4.326ZM8 1.018a6.974 6.974 0 0 1 4.546 1.688c-.689 1.405-2.28 2.65-4.546 2.946V1.018Zm1.06 6.244v5.396c2.25-.265 4.11-1.223 4.836-3.048a7.99 7.99 0 0 0-1.061-5.288c-.325 1.329-2.532 2.524-5.897 2.94h2.122ZM1.026 8c0-1.106.26-2.146.716-3.078C3.12 5.069 5.346 6.136 8 6.556v3.312C4.194 9.4 1.83 8.358 1.026 8Zm12.016 4.965C13.518 11.861 14.543 9.49 14.974 8c-.804.358-3.168 1.4-6.974 1.868v3.312a7.986 7.986 0 0 1-3.033.434c.71 1.258 2.19 2.186 3.868 2.37.585.064 1.189.064 1.774 0 1.68-.184 3.16-.112 3.868-1.37A6.975 6.975 0 0 1 13.042 12.965ZM8 14.982a6.975 6.975 0 0 1-4.546-1.688c.689-1.405 2.28-2.65 4.546-2.946v4.634Z"/></svg>
													</div>
													<a href="{{ node.field_website.uri }}" target="_blank" class="text-decoration-none fw-bold" style="color: var(--ibew-primary, #1e3a5f);">{{ node.field_website.title|default(node.field_website.uri|replace({'https://': '', 'http://': '', 'www.': ''})) }}</a>
												</li>
											{% endif %}
										</ul>
									</div>
								</div>

								{# Location Card #}
								<div class="col-md-6">
									<div class="card border-0 h-100 rounded-3 p-4" style="background: rgba(128,128,128, 0.08);">
										<h5 class="fw-bold font-oswald text-uppercase border-bottom border-secondary border-opacity-25 pb-2 mb-3">Location</h5>
										<div class="d-flex align-items-start gap-2">
											<div class="text-warning mt-1">
												<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewbox="0 0 16 16"><path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/></svg>
											</div>
											<address class="mb-0" style="color: inherit;">
												{% if node.field_street_address.value %}
													{{ node.field_street_address.value }}<br>
												{% endif %}
												{% if node.field_city.value or node.field_state.value or node.field_zip.value %}
													{{ node.field_city.value }}
													{% if node.field_city.value and node.field_state.value %},
													{% endif %}
													{{ node.field_state.value }}
													{{ node.field_zip.value }}
												{% else %}
													<span class="opacity-75 fst-italic">Address not provided</span>
												{% endif %}
											</address>
										</div>

										{% if node.field_street_address.value or node.field_city.value %}
											<div class="mt-3 text-end">
												{% set map_url = 'https://www.google.com/maps/dir/?api=1&destination=' ~ (node.field_street_address.value ~ ' ' ~ node.field_city.value ~ ' ' ~ node.field_state.value ~ ' ' ~ node.field_zip.value)|url_encode %}
												<a href="{{ map_url }}" target="_blank" class="btn btn-sm btn-primary">
													<i class="bi bi-car-front"></i>
													Get Directions
												</a>
											</div>
										{% endif %}
									</div>
								</div>
							</div>

							{% if node.field_service_areas.value %}
								<div class="mb-4">
									<h5 class="fw-bold font-oswald text-uppercase border-bottom border-secondary border-opacity-25 pb-2 mb-3">Service Areas</h5>
									<p style="color: inherit;">{{ node.field_service_areas.value }}</p>
								</div>
							{% endif %}

							{% if node.body.value %}
								<div class="mt-4 pt-4 border-top border-secondary border-opacity-25">
									<h5 class="fw-bold font-oswald text-uppercase mb-3">About
										{{ label }}</h5>
									<div style="color: inherit;">
										{{ node.body.value|raw }}
									</div>
								</div>
							{% endif %}

						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

</article>
