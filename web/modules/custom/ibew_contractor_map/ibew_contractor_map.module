<?php

/**
 * @file
 * IBEW Contractor Map module file.
 */

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\node\NodeInterface;

/**
 * Implements hook_help().
 */
function ibew_contractor_map_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.ibew_contractor_map':
      return '<p>IBEW Contractor Map adds map functionality to the contractor search page.</p>';
  }
}

/**
 * Implements hook_theme().
 */
function ibew_contractor_map_theme() {
  return [
    'contractor_map_container' => [
      'template' => 'contractor-map-container',
      'variables' => [
        'contractors' => [],
        'map_id' => 'contractor-map',
      ],
    ],
  ];
}

/**
 * Implements hook_page_attachments().
 */
function ibew_contractor_map_page_attachments(array &$page) {
  $route_name = \Drupal::routeMatch()->getRouteName();
  
  // Only add libraries on the contractors page.
  if ($route_name === 'view.contractors.page_1') {
    // Get API Key from config or fallback to provided key
    $config = \Drupal::config('ibew_contractor_map.settings');
    $api_key = $config->get('google_maps_api_key') ?: 'AIzaSyB5HikunMY2rPla7Xug_6YMIHqdE3u3_0g';

    if ($api_key) {
      // Load Google Maps API with additional libraries and clustering
      $page['#attached']['html_head'][] = [
        [
          '#tag' => 'script',
          '#attributes' => [
            'src' => 'https://maps.googleapis.com/maps/api/js?key=' . $api_key . '&libraries=places,geometry&callback=initContractorMap',
            'async' => TRUE,
            'defer' => TRUE,
          ],
        ],
        'google_maps_api',
      ];
    }

    $page['#attached']['library'][] = 'ibew_contractor_map/contractor-map';
    
    // Get contractor data and pass to JavaScript.
    /** @var \Drupal\ibew_contractor_map\Service\ContractorDataService $data_service */
    $data_service = \Drupal::service('ibew_contractor_map.contractor_data_service');
    $contractors = $data_service->getContractorData();
    
    $page['#attached']['drupalSettings']['ibewContractorMap']['contractors'] = $contractors;
  }
}

/**
 * Implements hook_preprocess_page().
 */
function ibew_contractor_map_preprocess_page(&$variables) {
  $route_name = \Drupal::routeMatch()->getRouteName();
  
  // Add map container to contractors page - but template already has one, so we don't need to add.
  // The module adds Google Maps API and JavaScript via page_attachments.
  if ($route_name === 'view.contractors.page_1') {
    // Log for debugging
    \Drupal::logger('ibew_contractor_map')->info('Contractors page detected');
  }
}
