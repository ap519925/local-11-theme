{#
/**
 * @file
 * Styleguide page template.
 * Visualize theme colors, typography, buttons, and components.
 */
#}
{% include '@ibew_theme/includes/header.html.twig' %}

<div class="ibew-page bg-light pb-5">

	<section class="py-5 bg-white border-bottom">
		<div class="container text-center">
			<h1 class="display-4 fw-bold font-oswald text-uppercase mb-3">Theme Styleguide</h1>
			<p class="lead text-muted">Visual reference for colors, typography, buttons, and components used in the IBEW Theme.</p>
		</div>
	</section>

	<div
		class="container py-5">

		{# 1. COLORS #}
		<div class="mb-6">
			<h2 class="h3 font-oswald text-uppercase border-bottom pb-2 mb-4">Color Palette</h2>
			<div
				class="row g-4">

				{# Use inline styles to force the variables so they show correctly even if CSS hasn't reloaded yet #}
				{% set swatches = [
            {'var': '--ibew-primary', 'name': 'Primary', 'hex': '#313F6B', 'desc': 'Dark Blue - Main Brand Color'},
            {'var': '--ibew-secondary', 'name': 'Secondary', 'hex': '#983A54', 'desc': 'Dark Raspberry - Secondary Brand Color'},
            {'var': '--ibew-tertiary', 'name': 'Tertiary', 'hex': '#E27859', 'desc': 'Terra Cotta - Accent/Highlight'},
            {'var': '--ibew-accent', 'name': 'Accent', 'hex': '#CFA655', 'desc': 'Gold - Emphasis & CTAs'},
            {'var': '--ibew-bg-light', 'name': 'Background', 'hex': '#FEFEFE', 'desc': 'Off-White - Page Background'},
            {'var': '--ibew-card-bg', 'name': 'Card Background', 'hex': '#E8DFC1', 'desc': 'Beige/Cream - Card Surface'}
        ] %}

				{% for swatch in swatches %}
					<div class="col-md-4 col-lg-2">
						<div class="card h-100 shadow-sm border-0">
							<div class="card-img-top" style="height: 120px; background-color: var({{ swatch.var }});"></div>
							<div class="card-body">
								<h5 class="card-title h6 fw-bold mb-1">{{ swatch.name }}</h5>
								<code class="d-block mb-2 text-muted">{{ swatch.var }}</code>
								<div class="small text-muted">{{ swatch.hex }}</div>
								<div class="small mt-2">{{ swatch.desc }}</div>
							</div>
						</div>
					</div>
				{% endfor %}
			</div>
		</div>

		{# 2. TYPOGRAPHY #}
		<div class="mb-6 py-5">
			<h2 class="h3 font-oswald text-uppercase border-bottom pb-2 mb-4">Typography</h2>
			<div class="row">
				<div class="col-md-6">
					<h3 class="h5 text-muted mb-3">Headings (Oswald)</h3>
					<h1 class="display-1 font-oswald fw-bold">Display 1</h1>
					<h1 class="font-oswald fw-bold">Heading 1</h1>
					<h2 class="font-oswald fw-bold">Heading 2</h2>
					<h3 class="font-oswald fw-bold">Heading 3</h3>
					<h4 class="font-oswald fw-bold">Heading 4</h4>
					<h5 class="font-oswald fw-bold">Heading 5</h5>
					<h6 class="font-oswald fw-bold">Heading 6</h6>
				</div>
				<div class="col-md-6">
					<h3 class="h5 text-muted mb-3">Body Text (Open Sans / Sans-Serif)</h3>
					<p class="lead">Lead paragraph: The IBEW Local 90 represents the most skilled electrical workers in New Haven.</p>
					<p>Standard paragraph: Lorem ipsum dolor sit amet, consectetur adipiscing elit. Curabitur sed metus at lectus gravida commodo. Integer feugiat, nulla nec ullamcorper lobortis, sem est placerat ipsum, nec convallis ipsum di.</p>
					<p class="small text-muted">Small text: Copyright &copy; 2023 IBEW Local 90.</p>
					<p>
						<strong>Bold text</strong>,
						<em>Italic text</em>,
						<a href="#" style="color: var(--ibew-secondary);">Link text</a>.</p>
				</div>
			</div>
		</div>

		{# 3. BUTTONS #}
		<div class="mb-6 py-5">
			<h2 class="h3 font-oswald text-uppercase border-bottom pb-2 mb-4">Buttons</h2>
			<div class="d-flex flex-wrap gap-3 mb-4">
				<button class="ibew-btn-lg" style="background-color: var(--ibew-primary); color: white;">Primary Button</button>
				<button class="ibew-btn-lg" style="background-color: var(--ibew-secondary); color: white;">Secondary Button</button>
				<button class="ibew-btn-lg" style="background-color: var(--ibew-accent); color: var(--ibew-primary);">Accent Button (Gold)</button>
				<button class="ibew-btn-lg" style="background-color: var(--ibew-tertiary); color: white;">Tertiary Button</button>
			</div>
			<div class="d-flex flex-wrap gap-3">
				<button class="ibew-btn-lg" style="background-color: transparent; border: 2px solid var(--ibew-primary); color: var(--ibew-primary);">Outline Primary</button>
				<button class="ibew-btn-lg" style="background-color: transparent; border: 2px solid var(--ibew-secondary); color: var(--ibew-secondary);">Outline Secondary</button>
			</div>
		</div>

		{# 4. CARDS #}
		<div class="mb-6 py-5">
			<h2 class="h3 font-oswald text-uppercase border-bottom pb-2 mb-4">Cards & Components</h2>
			<div
				class="row g-4">

				{# News Card Mockup #}
				<div class="col-md-4">
					<h4 class="h6 text-muted mb-3">News Card</h4>
					<div class="card h-100 border-0 shadow-sm ibew-card">
						<div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px; color: #aaa;">
							Image Placeholder
						</div>
						<div class="card-body d-flex flex-column p-4" style="background-color: var(--ibew-card-bg);">
							<div class="mb-2 text-uppercase fw-bold" style="font-size: 0.75rem; color: var(--ibew-accent);">
								Jan 15, 2024
							</div>
							<h3 class="h4 card-title fw-bold font-oswald mb-3">
								<a href="#" style="color: var(--ibew-primary); text-decoration: none;">New Training Center Opens</a>
							</h3>
							<p class="card-text text-muted mb-4 flex-grow-1">
								IBEW Local 90 is proud to announce the grand opening of our state-of-the-art training facility...
							</p>
							<a href="#" class="btn btn-link p-0 text-decoration-none fw-bold" style="color: var(--ibew-secondary);">
								Read More &rarr;
							</a>
						</div>
					</div>
				</div>

				{# Event Card Mockup #}
				<div class="col-md-4">
					<h4 class="h6 text-muted mb-3">Event Card</h4>
					<div
						class="ibew-event-card d-flex flex-column h-100 shadow-sm rounded-3 overflow-hidden position-relative group" style="background-color: var(--ibew-card-bg);">
						<!-- Date Badge -->
						<div class="position-absolute top-0 start-0 bg-white shadow-sm text-center p-2 rounded-bottom-3 ms-3 z-1" style="width: 60px;">
							<span class="d-block text-uppercase fw-bold small" style="color: var(--ibew-secondary);">FEB</span>
							<span class="d-block display-6 fw-bold lh-1" style="color: var(--ibew-primary);">24</span>
						</div>

						<div class="card-img-top bg-light" style="height: 180px;"></div>

						<div class="card-body p-4 pt-5 d-flex flex-column flex-grow-1">
							<div class="mb-2">
								<span class="badge rounded-pill fw-normal" style="background-color: var(--ibew-accent); color: var(--ibew-primary);">Meeting</span>
							</div>
							<h3 class="h5 card-title fw-bold font-oswald mb-2">
								<a href="#" class="text-decoration-none stretched-link" style="color: var(--ibew-primary);">General Membership Meeting</a>
							</h3>
							<div class="text-muted small mb-3">
								<i class="bi bi-clock me-1"></i>
								6:00 PM - 8:00 PM
							</div>
							<div class="mt-auto pt-3 border-top">
								<span class="small text-muted">
									<i class="bi bi-geo-alt me-1"></i>
									Union Hall</span>
							</div>
						</div>
					</div>
				</div>

				{# Stats / Generic Card #}
				<div class="col-md-4">
					<h4 class="h6 text-muted mb-3">Stats / Info Card</h4>
					<div class="p-4 rounded-4 shadow-sm h-100 d-flex flex-column justify-content-center align-items-center text-center style-card" style="background-color: white; border-top: 4px solid var(--ibew-tertiary);">
						<div class="display-4 fw-bold font-oswald mb-2" style="color: var(--ibew-tertiary);">100%</div>
						<div class="h5 text-uppercase text-muted">Safety Record</div>
						<p class="small text-muted mt-2">Commitment to excellence in every project we undertake.</p>
					</div>
				</div>

			</div>
		</div>

	</div>

</div>

{% include '@ibew_theme/includes/footer.html.twig' %}
