{#
/**
 * @file
 * Theme implementation for 'Hero Overlay' block type.
 */
#}
{% set title = content.field_display_title|field_value %}
{% set description = content.field_hero_description|field_value %}
{% set logo = content.field_hero_logo|field_value %}

<div
	class="hero-content-flex-wrapper d-flex flex-column align-items-center justify-content-center text-center h-100 px-3 position-relative">

	{# Logo Image - displayed above title, auto-scaled to appropriate size #}
	<div class="hero-logo-container" style="order: -10 !important; display: flex !important; justify-content: center !important; align-items: center !important; width: 100% !important; max-width: 300px !important; margin: 0 auto 1.5rem auto !important; z-index: 50; position: relative;">
		{{ content.field_hero_logo }}
	</div>


	<h1 class="font-oswald fw-bold text-white mb-3 text-uppercase display-2 drop-shadow-lg" style="letter-spacing: 0.05em; order: 10 !important;">
		{{ title }}
	</h1>

	<p class="text-white fs-3 mb-5 font-sans drop-shadow-md mx-auto fw-light" style="max-width: 800px; opacity: 0.9; order: 20 !important;">
		{{ description }}
	</p>

	<div class="hero-actions-wrapper d-flex justify-content-center" style="order: 30 !important;">
		{{ content.field_hero_actions }}
	</div>

</div>
