<article
	class="card ibew-card h-100 p-0 overflow-hidden d-flex flex-column border-0 shadow-sm rounded-4" data-name="{{ label }}" data-phone="{{ node.field_phone.value }}" data-service-areas="{{ node.field_service_areas.value }}">

	{# Image/Logo Section #}
	<div class="card-img-top position-relative bg-light w-100 d-flex align-items-center justify-content-center p-4 border-bottom" style="height: 200px;">
		{% if node.field_image.entity %}
			{% set image_url = file_url(node.field_image.entity.uri.value) %}
			<img src="{{ image_url }}" alt="{{ node.field_image.alt }}" class="img-fluid" style="max-height: 100%; max-width: 100%; object-fit: contain;">
		{% else %}
			{# Placeholder Icon #}
			<div class="text-secondary opacity-25">
				<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-briefcase-fill" viewbox="0 0 16 16">
					<path d="M6.5 1A1.5 1.5 0 0 0 5 2.5V3H1.5A1.5 1.5 0 0 0 0 4.5v1.384l7.614 2.03a1.5 1.5 0 0 0 .772 0L16 5.884V4.5A1.5 1.5 0 0 0 14.5 3H11v-.5A1.5 1.5 0 0 0 9.5 1h-3zm0 1h3a.5.5 0 0 1 .5.5V3H6v-.5a.5.5 0 0 1 .5-.5z"/>
					<path d="M0 12.5A1.5 1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5V6.85L8.129 8.947a.5.5 0 0 1-.258 0L0 6.85v5.65z"/>
				</svg>
			</div>
		{% endif %}
	</div>

	<div class="card-body p-4 d-flex flex-column flex-grow-1 bg-white">
		{# Specialties Badges #}
		{# Direct access to referenced entities labels #}
			<div class="d-flex flex-wrap gap-1 mb-2"> {% for item in node.field_specialties %}
				<span class="badge bg-secondary text-white rounded-1 px-2 py-1 text-uppercase" style="font-size: 0.7rem;">
					{{ item.entity.label }}
				</span>
			{% endfor %}
		</div>

		<h3 class="card-title fw-bold mb-2 font-oswald text-uppercase text-dark lh-base">
			<a href="{{ url }}" class="text-decoration-none text-dark stretched-link">
				{{ label }}
			</a>
		</h3>

		{% if node.field_contact_person.value %}
			<p class="text-muted small mb-3">
				<i class="bi bi-person-fill me-1 text-primary"></i>
				{{ node.field_contact_person.value }}
			</p>
		{% endif %}

		<div class="card-text text-muted opacity-75 small mb-4 flex-grow-1">
			{% if node.body.summary or node.body.value %}
				{{ node.body.value|striptags|slice(0, 120) }}...
			{% endif %}

			{# Service Areas #}
			{% if node.field_service_areas.value %}
				<div class="mt-3 text-dark border-top pt-2">
					<strong class="text-primary text-uppercase" style="font-size: 0.75rem;">Service Areas:</strong><br>
					{{ node.field_service_areas.value }}
				</div>
			{% endif %}
		</div>

		<div
			class="mt-auto position-relative" style="z-index: 2;">
			{# z-index needed because of stretched-link above #}
			<div class="d-flex flex-column gap-2">
				{% if node.field_phone.value %}
					<a href="tel:{{ node.field_phone.value }}" class="text-decoration-none text-dark d-flex align-items-center gap-2 small hover-primary">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-telephone-fill text-primary" viewbox="0 0 16 16">
							<path fill-rule="evenodd" d="M1.885.511a1.745 1.745 0 0 1 2.61.163L6.29 2.98c.329.445.445.974.315 1.494l-.547 2.19a.678.678 0 0 0 .178.643l2.457 2.457a.678.678 0 0 0 .644.178l2.189-.547a1.745 1.745 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.634 18.634 0 0 1-7.01-4.42 18.634 18.634 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877L1.885.511z"/>
						</svg>
						{{ node.field_phone.value }}
					</a>
				{% endif %}

				{% if node.field_email.value %}
					<a href="mailto:{{ node.field_email.value }}" class="text-decoration-none text-dark d-flex align-items-center gap-2 small hover-primary">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-envelope-fill text-primary" viewbox="0 0 16 16">
							<path d="M.05 3.555A2 2 0 0 1 2 2h12a2 2 0 0 1 1.95 1.555L8 8.414.05 3.555ZM0 4.697v7.104l5.803-3.558L0 4.697ZM6.761 8.83l-6.57 4.027A2 2 0 0 0 2 14h12a2 2 0 0 0 1.808-1.144l-6.57-4.027L8 9.586l-1.239-.757Zm3.436-.586L16 11.801V4.697l-5.803 3.546Z"/>
						</svg>
						{{ node.field_email.value }}
					</a>
				{% endif %}

				{% if node.field_website.uri %}
					<a href="{{ node.field_website.uri }}" target="_blank" class="btn btn-outline-primary btn-sm w-100 mt-2 fw-bold">
						Visit Website
					</a>
				{% endif %}
			</div>
		</div>

	</div>
</article>
