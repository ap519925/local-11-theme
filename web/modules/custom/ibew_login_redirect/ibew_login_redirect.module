<?php

/**
 * @file
 * IBEW Login Redirect module.
 */

use Drupal\Core\Form\FormStateInterface;
use Symfony\Component\HttpFoundation\RedirectResponse;

/**
 * Implements hook_form_FORM_ID_alter() for user_login_form.
 */
function ibew_login_redirect_form_user_login_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  $form['#submit'][] = 'ibew_login_redirect_user_login_submit';
}

/**
 * Custom submit handler for user login form.
 */
function ibew_login_redirect_user_login_submit($form, FormStateInterface $form_state) {
  // Redirect to /admin/content after login
  $form_state->setRedirect('system.admin_content');
}
