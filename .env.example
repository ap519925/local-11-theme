# ===========================================
# IBEW Drupal 11 - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to Git.

# ----- Production Database -----
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password
DB_HOST=localhost
DB_PORT=3306

# ----- Drupal -----
DRUPAL_HASH_SALT=generate-a-random-64-char-string-here

# ----- SSH Deployment (for GitHub Actions) -----
# These are set as GitHub Secrets, not here.
# SSH_HOST=your-server-ip-or-hostname
# SSH_USER=your-cpanel-username
# SSH_KEY=your-private-key-contents
# SSH_PORT=22
# DEPLOY_PATH=/home/username/public_html
